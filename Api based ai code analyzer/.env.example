# AI Code Analyzer - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# AI PROVIDER CONFIGURATION (GEMINI ONLY)
# ============================================
# Provider is always "gemini" - this is required
AI_PROVIDER=gemini

# ============================================
# GOOGLE GEMINI CONFIGURATION (REQUIRED)
# ============================================
# Your Google AI Studio API key
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyDlFcSELfaLUs6Y-djaINd4OFkgMtTBa0c

# ============================================
# MODEL CONFIGURATION
# ============================================
# Gemini model name (e.g., gemini-2.0-flash, gemini-1.5-pro, gemini-pro)
AI_MODEL_NAME=gemini-2.0-flash

# Temperature (0 for deterministic output)
AI_TEMPERATURE=0

# Request timeout in seconds
AI_TIMEOUT=60

# Maximum retry attempts on failure
AI_MAX_RETRIES=3
